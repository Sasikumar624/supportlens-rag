# SupportLens local environment

APP_NAME=SupportLens
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_MAX_REQUEST_BYTES=32768
API_MAX_QUESTION_CHARS=2000
ENABLE_QUERY_PIPELINE=false

# Qdrant local defaults
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportlens_chunks

# Runtime profile: high-accuracy retrieval with guarded LLM generation.
# Dense retrieval and reranking are enabled from local cache.
# LLM generation is enabled with timeout/fallback; if the generation model is
# unavailable or slow, the API falls back to extractive cited answers.

# Embeddings
DENSE_RETRIEVAL_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Keyword retrieval
KEYWORD_RETRIEVAL_TOP_K=10
KEYWORD_RETRIEVAL_MIN_SCORE=0.0

# Hybrid retrieval
HYBRID_RETRIEVAL_TOP_K=10
HYBRID_RRF_K=60

# Reranking
RERANKING_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_TOP_K=15
RERANKER_FINAL_TOP_K=15

# Generation model. Enabled with timeout/fallback.
LLM_PROVIDER=local
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL_TYPE=causal
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.0
LLM_DO_SAMPLE=false
LLM_GENERATION_ENABLED=true
LLM_GENERATION_TIMEOUT_SECONDS=8

# No-answer handling
NO_ANSWER_MIN_SCORE=0.35
NO_ANSWER_MIN_CONTEXT_CHARS=30
