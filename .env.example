# SupportLens local environment

APP_NAME=SupportLens
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Qdrant local defaults
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportlens_chunks

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Generation model placeholder; final provider/model will be selected after evaluation.
LLM_PROVIDER=local
LLM_MODEL=
